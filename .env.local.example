# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase project settings → API → service_role (server only, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key (server only, never expose to the client)
ANTHROPIC_API_KEY=

# Sentry DSN — deliberately left unset locally. It's only configured in Vercel's
# Production environment, so local dev/testing never reports errors to Sentry.
NEXT_PUBLIC_SENTRY_DSN=
